{
  "name": "signalk-github-pages",
  "version": "0.2.0",
  "description": "Publish Signal K vessel telemetry to a GitHub Pages site \u2014 a static tracker, updated from the boat, with no server ashore.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "dev": "node scripts/dev-server.mjs"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-utility",
    "github-pages",
    "vessel-tracker",
    "gpx"
  ],
  "signalk": {
    "displayName": "GitHub Pages tracker"
  },
  "files": [
    "dist",
    "site",
    "public",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
