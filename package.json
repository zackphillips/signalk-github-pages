{
  "name": "signalk-github-pages",
  "version": "1.0.0",
  "description": "Publish Signal K vessel telemetry to a GitHub Pages site — a static tracker, updated from the boat, with no server ashore.",
  "author": "Zack Phillips",
  "homepage": "https://github.com/zackphillips/signalk-github-pages#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zackphillips/signalk-github-pages.git"
  },
  "bugs": {
    "url": "https://github.com/zackphillips/signalk-github-pages/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "dev": "node scripts/dev-server.mjs"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-utility",
    "signalk-category-cloud",
    "github-pages",
    "vessel-tracker",
    "gpx"
  ],
  "signalk": {
    "displayName": "GitHub Pages Vessel Tracker",
    "appIcon": "./icon.svg"
  },
  "files": [
    "dist",
    "site",
    "public",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.32.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
